# Copy to .env only if you want to try a real provider. Never commit .env.
# The default provider is the offline mock: no key, no network.
PROVIDER=mock
MOCK_SCENARIO=ok

# Secret used to sign the fake login tokens (dev only).
AUTH_SECRET=change-me-dev-only

# Optional real providers (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
