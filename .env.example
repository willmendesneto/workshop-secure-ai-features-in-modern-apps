# Copy to .env (repo root) only if you want to change the defaults or try a real provider.
# `npm run dev` loads it automatically. Never commit .env.
# The default provider is the offline mock: no key, no network.
PROVIDER=mock
# Mock behaviour: ok | malformed | injection-echo | slow
MOCK_SCENARIO=ok
# How long the `slow` scenario waits before answering (ms).
MOCK_SLOW_MS=15000

# Secret used to sign the fake login tokens (dev only).
AUTH_SECRET=change-me-dev-only

# Already configured for Exercise A (not enforced on step 1).
ASSISTANT_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Demo key accepted by the simulated provider at /fake-provider. Not a real secret.
# FAKE_PROVIDER_KEY=wsk_demo_7f3a9c1e5b2d4f60

# Optional real providers (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
